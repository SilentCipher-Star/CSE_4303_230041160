#include <iostream>
#include <vector>
#include <queue>
#include <algorithm>
using namespace std;

int main()
{
    int V, E, s;
    cin >> V >> E >> s;

    vector<vector<int>> adj(V + 1); // 1-based indexing
    for (int i = 0; i < E; i++)
    {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // Step 1: print adjacency list
    cout << "Adjacency list:" << endl;
    for (int i = 1; i <= V; i++)
    {
        cout << i << ": ";
        for (int v : adj[i])
            cout << v << " ";
        cout << endl;
    }

    // BFS attributes
    vector<string> color(V + 1, "WHITE");
    vector<int> distance(V + 1, -1);
    vector<int> predecessor(V + 1, -1);

    queue<int> q;
    q.push(s);
    color[s] = "GRAY";
    distance[s] = 0;

    vector<int> bfs_order;
    vector<pair<int, int>> bfs_edges;

    while (!q.empty())
    {
        int u = q.front();
        q.pop();
        bfs_order.push_back(u);

        for (int v : adj[u])
        {
            if (color[v] == "WHITE")
            {
                color[v] = "GRAY";
                distance[v] = distance[u] + 1;
                predecessor[v] = u;
                q.push(v);
                bfs_edges.push_back({u, v});
            }
        }
        color[u] = "BLACK";
    }

    // BFS order
    cout << "\nBFS order: ";
    for (int u : bfs_order)
        cout << u << " ";
    cout << endl;

    // Distances
    cout << "\nDistance from source: " << endl;
    for (int i = 1; i <= V; i++)
    {
        cout << i << "(" << distance[i] << ") ";
    }
    cout << endl;

    // Paths
    cout << "\nPaths from source: " << endl;
    for (int i = 1; i <= V; i++)
    {
        if (i == s)
        {
            cout << i << ": " << i << endl;
            continue;
        }
        if (distance[i] == -1)
        {
            cout << i << ": unreachable" << endl;
            continue;
        }
        vector<int> path;
        int x = i;
        while (x != -1)
        {
            path.push_back(x);
            x = predecessor[x];
        }
        reverse(path.begin(), path.end());
        cout << i << ": ";
        for (int j = 0; j < path.size(); j++)
        {
            cout << path[j];
            if (j != path.size() - 1)
                cout << "->";
        }
        cout << endl;
    }

    // BFS tree edges
    cout << "\nEdges of BFS tree:" << endl;
    for (auto e : bfs_edges)
        cout << e.first << " " << e.second << endl;

    return 0;
}
